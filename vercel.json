{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "framework": "vite",
  "functions": {
    "api/learning.js": {
      "runtime": "nodejs18.x"
    },
    "api/trades.js": {
      "runtime": "nodejs18.x"
    },
    "api/auth.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/learning",
      "destination": "/api/learning.js"
    },
    {
      "source": "/api/trades",
      "destination": "/api/trades.js"
    },
    {
      "source": "/api/trades/(.*)",
      "destination": "/api/trades.js"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth.js"
    },
    {
      "source": "/admin-panel",
      "destination": "/admin-panel.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/learning-test",
      "destination": "/learning-test.html"
    },
    {
      "source": "/api-test",
      "destination": "/api-test.html"
    },
    {
      "source": "/test-trades-api",
      "destination": "/test-trades-api.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}